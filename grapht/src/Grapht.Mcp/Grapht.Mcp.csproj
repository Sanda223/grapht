<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Grapht.Core\Grapht.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>grapht-mcp</ToolCommandName>
    <PackageId>Grapht.Mcp</PackageId>
    <Version>0.3.0</Version>
    <Description>MCP stdio server exposing an always-fresh knowledge graph of a .NET solution to GitHub Copilot.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sanda223/grapht</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sanda223/grapht</RepositoryUrl>
    <Authors>Sanda223</Authors>
  </PropertyGroup>

</Project>
